{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "frameforge-library",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "r2_buckets": [
    {
      "binding": "LIBRARY",
      "bucket_name": "frameforge-library"
    }
  ],
  "observability": {
    "enabled": true
  }
}
